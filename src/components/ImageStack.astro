---
import { ImageStackContent } from "../data/ImageStackContent.ts";
---

<div class="image-intro" aria-label="Introduction photographique">
    <div class="image-stack">
        {
            ImageStackContent.map((image) => (
                <figure
                    class="stack-card"
                    style={{
                        "--card-left": image.left,
                        "--card-top": image.top,
                        "--card-mobile-left": image.mobileLeft,
                        "--card-mobile-top": image.mobileTop,
                    }}
                >
                    <img
                        src={image.src}
                        alt={image.alt}
                        width="1050"
                        height="1400"
                        loading="eager"
                        decoding="async"
                    />
                </figure>
            ))
        }
    </div>
</div>

<script>
    const INTRO_DURATION = 3222; // 2522;
    const CONTACT_TRANSITION_DURATION = 450;

    const intro = document.querySelector<HTMLElement>(".image-intro");
    const cards = [...document.querySelectorAll<HTMLElement>(".stack-card")];
    const images = [
        ...document.querySelectorAll<HTMLImageElement>(".stack-card img"),
    ];

    function revealContact() {
        intro?.classList.add("is-leaving");
        document.dispatchEvent(new CustomEvent("landing:reveal-contact"));
    }

    function completeIntro() {
        if (intro) {
            intro.hidden = true;
        }

        document.documentElement.dataset.landingIntroComplete = "true";
        document.dispatchEvent(new CustomEvent("landing:intro-complete"));
    }

    async function prepareImages() {
        await Promise.all(
            images.map(async (image) => {
                if (!image.complete) {
                    await new Promise<void>((resolve) => {
                        image.addEventListener("load", () => resolve(), {
                            once: true,
                        });
                        image.addEventListener("error", () => resolve(), {
                            once: true,
                        });
                    });
                }

                if (image.naturalWidth > 0) {
                    await image.decode().catch(() => undefined);
                }
            }),
        );
    }

    function randomizeRevealOrder() {
        const shuffledCards = [...cards];

        for (let index = shuffledCards.length - 1; index > 0; index--) {
            const randomIndex = Math.floor(Math.random() * (index + 1));

            [shuffledCards[index], shuffledCards[randomIndex]] = [
                shuffledCards[randomIndex],
                shuffledCards[index],
            ];
        }

        shuffledCards.forEach((card, revealIndex) => {
            card.style.setProperty("--reveal-index", `${revealIndex}`);
        });
    }

    async function startIntro() {
        if (!intro || cards.length === 0) {
            revealContact();
            completeIntro();
            return;
        }

        const reducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;

        if (reducedMotion) {
            // return;
            revealContact();
            completeIntro();
            return;
        }

        await prepareImages();
        randomizeRevealOrder();
        intro.classList.add("is-ready");

        requestAnimationFrame(() => {
            requestAnimationFrame(() => {
                intro.classList.add("is-playing");
            });
        });

        window.setTimeout(
            revealContact,
            INTRO_DURATION - CONTACT_TRANSITION_DURATION,
        );
        window.setTimeout(completeIntro, INTRO_DURATION);
    }

    startIntro();
</script>

<style>
    .image-intro {
        position: fixed;
        inset: 0;
        z-index: 1;

        display: grid;
        place-items: center;

        overflow: hidden;
        background: #fff;
        opacity: 1;

        transition: opacity 450ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .image-intro.is-leaving {
        opacity: 0;
        pointer-events: none;
    }

    .image-stack {
        position: relative;
        width: 90vw;
        height: 88svh;
    }

    .stack-card {
        position: absolute;
        top: var(--card-top);
        left: var(--card-left);
        z-index: calc(var(--reveal-index, 0) + 1);

        width: min(36vw, calc(74svh * 0.76), 510px);
        aspect-ratio: 0.76;
        margin: 0;

        overflow: hidden;
        background: transparent;
        box-shadow: 0 20px 54px rgb(20 25 35 / 14%);
        opacity: 0;
        visibility: hidden;

        transform: translate(-50%, -50%);

        transition: opacity 120ms linear;
        transition-delay: calc(100ms + var(--reveal-index, 0) * 150ms);
        will-change: opacity;
    }

    .image-intro.is-playing .stack-card {
        opacity: 1;
    }

    .image-intro.is-ready .stack-card {
        visibility: visible;
    }

    .stack-card img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    @media (max-width: 768px) {
        .image-stack {
            width: 100vw;
            height: 90svh;
        }

        .stack-card {
            top: var(--card-mobile-top);
            left: var(--card-mobile-left);
            width: min(64vw, calc(60svh * 0.76), 280px);
            box-shadow: 0 14px 38px rgb(20 25 35 / 13%);
        }
    }

    @media (max-height: 560px) and (orientation: landscape) {
        .stack-card {
            width: min(28vw, calc(82svh * 0.76));
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .image-intro {
            display: none;
        }
    }
</style>
