---
import NewsletterSubscription from "./NewsletterSubscription.astro";

const email = "kunda.contact@gmail.com"; // "rokhia@kunda-store.com";
const newsletterUrl = "https://newsletter.example.com";
---

<main class="contact-screen" aria-hidden="true">
    <div class="contact-content">
        <!-- <p class="eyebrow">stay in contact</p> -->

        <div class="contact-links">
            <a class="email-link" href={`mailto:${email}`}>{email}</a>

            <div class="newsletter-reveal">
                <button
                    class="newsletter-trigger"
                    type="button"
                    aria-expanded="false"
                    aria-controls="newsletter-panel"
                >
                    Subscribe to the newsletter
                </button>

                <div
                    class="newsletter-panel"
                    id="newsletter-panel"
                    aria-hidden="true"
                >
                    <NewsletterSubscription action={newsletterUrl} />
                </div>
            </div>
        </div>
    </div>
</main>

<script>
    const contactScreen =
        document.querySelector<HTMLElement>(".contact-screen");
    const newsletterReveal =
        document.querySelector<HTMLElement>(".newsletter-reveal");
    const newsletterTrigger =
        document.querySelector<HTMLButtonElement>(".newsletter-trigger");
    const newsletterPanel =
        document.querySelector<HTMLElement>(".newsletter-panel");

    let newsletterPinned = false;

    function showContactScreen() {
        if (!contactScreen) return;

        contactScreen.classList.add("is-visible");
        contactScreen.setAttribute("aria-hidden", "false");
    }

    document.addEventListener("landing:reveal-contact", showContactScreen, {
        once: true,
    });

    function openNewsletter() {
        if (!newsletterReveal || !newsletterTrigger || !newsletterPanel) return;

        newsletterReveal.classList.add("is-open");
        newsletterTrigger.setAttribute("aria-expanded", "true");
        newsletterPanel.setAttribute("aria-hidden", "false");
    }

    function closeNewsletter() {
        if (!newsletterReveal || !newsletterTrigger || !newsletterPanel) return;

        newsletterReveal.classList.remove("is-open");
        newsletterTrigger.setAttribute("aria-expanded", "false");
        newsletterPanel.setAttribute("aria-hidden", "true");
    }

    newsletterReveal?.addEventListener("mouseenter", openNewsletter);
    newsletterReveal?.addEventListener("mouseleave", () => {
        if (!newsletterPinned) closeNewsletter();
    });

    newsletterTrigger?.addEventListener("click", () => {
        newsletterPinned = !newsletterPinned;

        if (newsletterPinned) {
            openNewsletter();
        } else {
            closeNewsletter();
        }
    });

    document.addEventListener("pointerdown", (event) => {
        if (
            newsletterPinned &&
            newsletterReveal &&
            !newsletterReveal.contains(event.target as Node)
        ) {
            newsletterPinned = false;
            closeNewsletter();
        }
    });

    document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;

        newsletterPinned = false;
        closeNewsletter();
        newsletterTrigger?.focus();
    });
</script>

<style>
    .contact-screen {
        position: fixed;
        inset: 0;
        z-index: 0;

        display: grid;
        place-items: center;

        min-height: 100vh;
        min-height: 100svh;
        padding: clamp(1.5rem, 4vw, 4rem);

        /* color:  #0e4fa8; */
        color: #0115d0;
        background: #fff;
        opacity: 0;
        pointer-events: none;
        transition:
            opacity 450ms cubic-bezier(0.22, 1, 0.36, 1),
            transform 450ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .contact-screen.is-visible {
        z-index: 2;
        opacity: 1;
        pointer-events: auto;
    }

    .contact-content {
        display: grid;
        justify-items: center;
        gap: clamp(1.5rem, 4vw, 2.75rem);
        width: min(100%, 52rem);
        text-align: center;
    }

    .eyebrow {
        margin: 0;
        /* color: rgb(14 79 168 / 58%); */
        color: rgb(1 21 208 / 58%);
        font-size: clamp(0.7rem, 1vw, 0.82rem);
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
    }

    .contact-links {
        display: grid;
        justify-items: center;
        gap: 0.35em;
        font-size: clamp(1.45rem, 3.2vw, 3.4rem);
        font-weight: 600;
        line-height: 1.05;
        letter-spacing: -0.04em;
        text-transform: uppercase;
    }

    .newsletter-reveal {
        position: relative;
    }

    .email-link {
        /* color: #0e4fa8; */
        color: #0115d0;
        text-decoration: none;
        overflow-wrap: anywhere;
    }

    .newsletter-trigger {
        padding: 0;
        border: 0;
        color: #0115d0;
        background: transparent;
        cursor: pointer;
        font: inherit;
        line-height: inherit;
        letter-spacing: inherit;
        text-transform: inherit;
    }

    .newsletter-panel {
        position: absolute;
        top: 100%;
        left: 50%;
        z-index: 3;

        width: min(90vw, 48rem);
        padding-top: clamp(1.25rem, 3vw, 2rem);

        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translate(-50%, 0.6rem);

        transition:
            opacity 160ms ease,
            transform 200ms cubic-bezier(0.22, 1, 0.36, 1),
            visibility 0s linear 200ms;
    }

    .newsletter-reveal:hover .newsletter-panel,
    .newsletter-reveal:focus-within .newsletter-panel,
    .newsletter-reveal.is-open .newsletter-panel {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translate(-50%, 0);

        transition:
            opacity 160ms ease,
            transform 200ms cubic-bezier(0.22, 1, 0.36, 1),
            visibility 0s;
    }

    .email-link:hover,
    .email-link:focus-visible,
    .newsletter-trigger:hover,
    .newsletter-trigger:focus-visible,
    .newsletter-trigger[aria-expanded="true"] {
        text-decoration: underline;
        text-decoration-thickness: 0.06em;
        text-underline-offset: 0.12em;
    }

    @media (max-width: 520px) {
        .contact-links {
            font-size: clamp(1.25rem, 6.2vw, 1.8rem);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .contact-screen {
            z-index: 2;
            opacity: 1;
            pointer-events: auto;
            transition: none;
        }
    }
</style>
