---
const links = [
    { href: "/studio", label: "Studio" },
    { href: "/newsletter", label: "Newsletter" },
    { href: "/about-us", label: "About us" },
    { href: "/contact", label: "Contact" },
];
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class:list={["site-header", { "awaiting-intro": pathname === "/" }]}>
    <a class="wordmark" href="/" aria-label="KÜNDA home">KÜNDA</a>
    <nav aria-label="Main navigation">
        {links.map(({ href, label }) => (
            <a href={href} aria-current={pathname === href ? "page" : undefined}>{label}</a>
        ))}
    </nav>
</header>

<style>
    .site-header {
        position: relative;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        padding: 1.5rem clamp(1.25rem, 4vw, 4rem);
        color: #0115d0;
        background: #fff;
    }
    .awaiting-intro {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 450ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    :global(html[data-landing-intro-complete="true"]) .awaiting-intro {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }
    @media (prefers-reduced-motion: reduce) {
        .awaiting-intro {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
            transition: none;
        }
    }
    a { color: inherit; text-decoration: none; }
    .wordmark { font-size: 1.5rem; font-weight: 750; letter-spacing: -0.06em; }
    nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
    nav a { padding-block: 0.5rem; font-size: 0.85rem; font-weight: 600; }
    a:hover, a[aria-current="page"] { text-decoration: underline; text-underline-offset: 0.3em; }
    a:focus-visible { outline: 2px solid currentColor; outline-offset: 5px; }
    @media (max-width: 520px) {
        .site-header { flex-direction: column; gap: 0.5rem; }
        nav { justify-content: center; gap: 0.5rem 1.1rem; }
    }
</style>
