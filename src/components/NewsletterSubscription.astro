---
interface Props {
    action: string;
}

const { action } = Astro.props;
---

<section class="newsletter" aria-labelledby="newsletter-title">
    <div class="newsletter-copy">
        <!-- <h2 id="newsletter-title">Welcome to KÜNDA!</h2> -->
        <p>
            A monthly selection of art, culture, favorite places and curated
            finds.
        </p>
    </div>

    <form class="newsletter-form" action={action} method="post">
        <label class="sr-only" for="newsletter-email">Email address</label>
        <input
            id="newsletter-email"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="email"
            placeholder="Email address"
            required
        />

        <button type="submit">Sign up</button>
    </form>

    <p class="privacy-note">We respect your privacy.</p>
</section>

<style>
    .newsletter {
        display: grid;
        justify-items: center;
        gap: clamp(1.25rem, 2.5vw, 2rem);
        width: min(100%, 48rem);
        color: #0115d0;
        text-align: center;
    }

    .newsletter-copy {
        display: grid;
        gap: 0.65rem;
        max-width: 44rem;
    }

    h2,
    p {
        margin: 0;
    }

    h2 {
        font-size: clamp(1.45rem, 3vw, 2.5rem);
        font-weight: 650;
        line-height: 1;
        letter-spacing: -0.04em;
        text-transform: uppercase;
    }

    .newsletter-copy p {
        font-size: clamp(0.9rem, 1.4vw, 1.05rem);
        font-weight: 500;
        line-height: 1.35;
        letter-spacing: 0.02em;
    }

    .newsletter-form {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        width: 100%;
        border: 1px solid rgb(1 21 208 / 35%);
        background: #fff;
    }

    input,
    button {
        min-height: clamp(3.75rem, 7vw, 4.75rem);
        border: 0;
        border-radius: 0;
        font: inherit;
    }

    input {
        min-width: 0;
        padding: 0 1.4rem;
        color: #0115d0;
        background: #fff;
        font-size: clamp(1rem, 1.8vw, 1.25rem);
        font-weight: 600;
        outline: none;
    }

    input::placeholder {
        color: rgb(1 21 208 / 42%);
        opacity: 1;
    }

    input:focus-visible {
        box-shadow: inset 0 0 0 2px #0115d0;
    }

    button {
        padding: 0 clamp(1.5rem, 4vw, 3rem);
        color: #fff;
        background: #0115d0;
        cursor: pointer;
        font-size: clamp(0.95rem, 1.8vw, 1.2rem);
        font-weight: 650;
        text-transform: uppercase;
    }

    button:hover,
    button:focus-visible {
        background: #00109f;
    }

    button:focus-visible {
        outline: 2px solid #0115d0;
        outline-offset: 3px;
    }

    .privacy-note {
        color: rgb(1 21 208 / 62%);
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    @media (max-width: 560px) {
        .newsletter-form {
            grid-template-columns: 1fr;
            border: 0;
            gap: 0.65rem;
        }

        input {
            border: 1px solid rgb(1 21 208 / 35%);
            text-align: center;
        }

        button {
            width: 100%;
        }
    }
</style>
