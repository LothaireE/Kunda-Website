---
import ImageStack from "../components/ImageStack.astro";
import CenterContent from "../components/CenterContent.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />

        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <meta
            name="description"
            content="KÜNDA, KÜNDA, a space and a community united around lifestyle, passions, sharing, and connecting with others."
        />
        <link
            rel="icon"
            type="image/png"
            href="/public/logos/kunda-logo-01.png"
        />
        <title>KÜNDA</title>
    </head>

    <body>
        <ImageStack />
        <CenterContent />
    </body>
</html>

<style is:global>
    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    html {
        min-width: 320px;
        min-height: 100%;
        background: #fff;

        font-family:
            Inter,
            ui-sans-serif,
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            sans-serif;
    }

    body {
        min-height: 100vh;
        min-height: 100svh;
        margin: 0;
        overflow: hidden;
        background: #fff;
    }
</style>
